<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hello_greeting_view_form" model="ir.ui.view">
        <field name="name">hello.greeting.view.form</field>
        <field name="model">hello.greeting</field>
        <field name="arch" type="xml">
            <form string="Say Hello">
                <sheet>
                    <div class="oe_title">
                        <h1>Hello Odoo</h1>
                    </div>
                    <group>
                        <field name="username" placeholder="Enter your username"/>
                    </group>
                    <group invisible="not greeting">
                        <field name="greeting" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hello_greeting_action" model="ir.actions.act_window">
        <field name="name">Say Hello</field>
        <field name="res_model">hello.greeting</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hello_greeting_view_form"/>
    </record>
</odoo>
